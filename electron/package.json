{
  "name": "faststudy",
  "productName": "FastStudy",
  "private": true,
  "version": "0.1.0",
  "description": "Launcher and window for the four FastStudy services",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always"
  },
  "devDependencies": {
    "electron": "^44.1.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.faststudy.app",
    "productName": "FastStudy",
    "directories": {
      "output": "dist"
    },
    "files": [
      "*.js",
      "*.html",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../delivery/stage",
        "to": "."
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "ShalomPrinz",
      "repo": "fast-study",
      "releaseType": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "FastStudy",
      "artifactName": "FastStudy-Setup-${version}.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
